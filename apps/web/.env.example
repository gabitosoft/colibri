# Frontend (Vite) — these are baked in at BUILD time, so they must be present
# when the image is built, not just at runtime.

# Portal identity provider (used for SSO redirect + silent /refresh-cookie call)
# Dev:  http://localhost:3001 is NOT used here; the web talks to the portal web app
# Dev:  http://localhost:5173 portal, or leave the prod value
# Prod: https://portal.gabitosoft.cloud
VITE_PORTAL_URL=https://portal.gabitosoft.cloud

# Name of the shared session cookie set by the portal (must match the portal's
# PORTAL_COOKIE_NAME).
VITE_PORTAL_COOKIE_NAME=token

# This app's slug as registered in the portal (used in the SSO login redirect).
VITE_APP_SLUG=colibri

# Google Maps (existing feature)
VITE_GOOGLE_MAPS_API_KEY=
