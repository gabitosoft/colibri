NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=colibri

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Portal SSO (identity provider)
# Dev:  http://localhost:3001
# Prod: https://portal.gabitosoft.cloud/authsvc
AUTH_BASE_URL=http://localhost:3001
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

# Cookie issued after SSO exchange
# Leave blank in dev (no cross-domain); set to .gabitosoft.cloud in prod
COOKIE_DOMAIN=

# Frontend origin — used for the post-SSO redirect
# Dev:  http://localhost:5173
# Prod: https://colibri.gabitosoft.cloud
APP_ORIGIN=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173
