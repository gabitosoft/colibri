NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=colibri

# JWT (local direct-login tokens only; portal SSO tokens are RS256, see below)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Portal SSO (identity provider)
# AUTH_BASE_URL: server-to-server base for the one-time ticket exchange.
#   Dev:  http://localhost:3001
#   Prod: https://portal.gabitosoft.cloud/authsvc
AUTH_BASE_URL=http://localhost:3001
# RECOMMENDED for prod: the portal's PUBLIC key (PEM). When set, portal tokens
# are verified locally with NO network call — robust behind Cloudflare / in
# container networks. Get it from the portal's keys/jwt-public.pem (the same key
# behind the live JWKS). Paste as one line with literal \n between PEM lines:
#   PORTAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"
# If set, AUTH_JWKS_URL is ignored.
PORTAL_JWT_PUBLIC_KEY=
# AUTH_JWKS_URL (fallback, used only when PORTAL_JWT_PUBLIC_KEY is empty): where
# colibri fetches the portal's public keys. Must be reachable from this backend.
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# AUTH_JWT_ISSUER: MUST exactly equal the portal's JWT_ISSUER, or every portal
# token is rejected (401 loop). Dev: http://localhost:3001
AUTH_JWT_ISSUER=http://localhost:3001

# Cookie domain for the token cookie set after SSO exchange.
# Leave blank in dev (host-only); set to the shared parent domain in prod.
#   Prod: .gabitosoft.cloud
COOKIE_DOMAIN=

# Frontend origin — used for the post-SSO redirect
# Dev:  http://localhost:5173
# Prod: https://colibri.gabitosoft.cloud
APP_ORIGIN=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173
